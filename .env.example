# =============================================================================
# LMEW-MS — Environment Variables
# Copy this file to .env in the app that needs it (do NOT commit .env files)
# =============================================================================

# --- Supabase (required by all client apps) ----------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_BASE=https://your-project.supabase.co/functions/v1

# --- Supabase Edge Function Secrets (NEVER expose to client) -----------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Paystack Payment Gateway ------------------------------------------------
# Web clients use the PUBLIC key for Paystack Inline checkout
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Edge function only — NEVER expose to client
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_signature_secret

# --- Expo Push Notifications (Edge Function secret) -------------------------
EXPO_ACCESS_TOKEN=your_expo_access_token

# --- LMEW Company Info -------------------------------------------------------
LMEW_HOTLINE=+254700000000
LMEW_LOCATION=Kisumu Port / Lake Victoria, Kenya

# --- Callback URLs (set to your deployed domain in production) ---------------
# Paystack redirects here after payment
PAYSTACK_CALLBACK_URL=https://your-domain.com/payment/callback
