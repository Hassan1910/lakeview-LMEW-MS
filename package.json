{
  "name": "lmew-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Lakeview Marine Engineering Works Management System",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "turbo dev --filter=@lmew/admin-web --filter=@lmew/mobile",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter @lmew/shared-types test",
    "db:types": "supabase gen types typescript --local > packages/shared-types/src/database.types.ts",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12"
  }
}
