          "responded_by": {
            "type": "uuid",
            "fk": "profiles.id"
          },
          "created_at": {
            "type": "timestamptz",
            "default": "now()"
          }
        },
        "indexes": [
          "service_request_id",
          "rating"
        ]
      },
      "notifications": {
        "columns": {
          "id": {
            "type": "uuid",
            "pk": true,
            "default": "gen_random_uuid()"
          },
          "user_id": {
            "type": "uuid",
            "fk": "profiles.id",
            "not_null": true
          },
          "type": {
            "type": "notification_type",
            "not_null": true
          },
          "title": {
            "type": "text",
            "not_null": true
          },
          "body": {
            "type": "text"
          },
          "data": {
            "type": "jsonb"
          },
          "read_at": {
            "type": "timestamptz"
          },
          "created_at": {
            "type": "timestamptz",
            "default": "now()"
          }
        },
        "indexes": [
          "user_id",
          "read_at",
          "created_at"
        ]
      },
      "messages": {
        "description": "Threaded messages between customer and assigned staff on a service request.",
        "columns": {
          "id": {
            "type": "uuid",
            "pk": true,
            "default": "gen_random_uuid()"
          },
          "service_request_id": {
            "type": "uuid",
            "fk": "service_requests.id",
            "on_delete": "cascade"
          },
          "sender_id": {
            "type": "uuid",
            "fk": "profiles.id",
            "not_null": true
          },
          "body": {
            "type": "text"
          },
          "attachment_url": {
            "type": "text"
          },
          "created_at": {
            "type": "timestamptz",
            "default": "now()"
          }
        },
        "indexes": [
          "service_request_id",
          "created_at"
        ]
      },
      "audit_logs": {
        "columns": {
          "id": {
            "type": "bigserial",
            "pk": true
          },
          "actor_id": {
            "type": "uuid",
            "fk": "profiles.id"
          },
          "action": {
            "type": "text"
          },
          "entity": {
            "type": "text"
          },
          "entity_id": {
            "type": "uuid"
          },
          "before": {
            "type": "jsonb"
          },
          "after": {
            "type": "jsonb"
          },
          "created_at": {
            "type": "timestamptz",
            "default": "now()"
          }
        }
      },
      "company_info": {
        "description": "Single-row table for About Us / Contact Us content.",
        "columns": {
          "id": {
            "type": "int",
            "pk": true,
            "default": 1
          },
          "name": {
            "type": "text",
            "default": "Lakeview Marine Engineering Works"
          },
          "about": {
            "type": "text"
          },
          "mission": {
            "type": "text"
          },
          "vision": {
            "type": "text"
          },
          "phone": {
            "type": "text"
          },
          "email": {
            "type": "text"
          },
          "address": {
            "type": "text"
          },
          "latitude": {
            "type": "numeric(9,6)"
          },
          "longitude": {
            "type": "numeric(9,6)"
          },
          "updated_at": {
            "type": "timestamptz",
            "default": "now()"
          }
        }
      }
    },
    "storage_buckets": {
      "avatars": {
        "public": true,
        "path_pattern": "{user_id}/avatar.{ext}"
      },
      "vessel-photos": {
        "public": false,
        "path_pattern": "{customer_id}/{vessel_id}/{filename}"
      },
      "service-attachments": {
        "public": false,
        "path_pattern": "{service_request_id}/{filename}"
      },
      "work-order-media": {
        "public": false,
        "path_pattern": "{work_order_id}/{filename}"
      },
      "quotation-pdfs": {
        "public": false,
        "path_pattern": "{quotation_id}/{filename}"
      },
      "invoice-pdfs": {
        "public": false,
        "path_pattern": "{invoice_id}/{filename}"
      },
      "reports": {
        "public": false,
        "path_pattern": "{user_id}/{report_id}.{ext}"
      }
    },
    "functions_and_triggers": [
      {
        "name": "handle_new_user",
        "type": "trigger",
        "on": "auth.users insert",
        "action": "create profiles row"
      },
      {
        "name": "set_updated_at",
        "type": "trigger",
        "on": "any table with updated_at",
        "action": "set updated_at = now()"
      },
      {
        "name": "log_status_change",
        "type": "trigger",
        "on": "service_requests update of status",
        "action": "insert into service_request_status_history"
      },
      {
        "name": "generate_service_request_code",
        "type": "trigger",
        "on": "service_requests insert",
        "action": "assign code like LMEW-SR-2025-0001"
      },
      {
        "name": "generate_invoice_code",
        "type": "trigger",
        "on": "invoices insert",
        "action": "assign code like LMEW-INV-2025-0001"
      },
      {
        "name": "decrement_stock_on_work_order_part",
        "type": "trigger",
        "on": "work_order_parts insert",
        "action": "insert stock_movement out + update inventory quantity"
      },
      {
        "name": "notify_low_stock",
        "type": "trigger",
        "on": "inventory_items update",
        "action": "if quantity_on_hand <= reorder_level -> insert notifications for store_manager + administrator"
      },
      {
        "name": "recalc_quotation_totals",
        "type": "trigger",
        "on": "quotation_items insert/update/delete",
        "action": "recalculate quotations.subtotal, tax, total"
      },
      {
        "name": "recalc_invoice_balance",
        "type": "trigger",
        "on": "payments insert/update",
        "action": "recalculate invoices.amount_paid and status"
      }
    ]
  }
}